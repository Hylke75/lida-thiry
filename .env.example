# Supabase — project "lida-thiry" (ref hzuhkollroehnrsghyax, eu-central-1)
# Kopieer dit bestand naar .env.local voor lokale ontwikkeling.
NEXT_PUBLIC_SUPABASE_URL=https://hzuhkollroehnrsghyax.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_RJa0sZq18sprYJjC9g38pA_q6QrzvNd

# Server-only (NOOIT als NEXT_PUBLIC_ en nooit committen).
# Service-role/secret-sleutel van Supabase (omzeilt RLS).
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Mollie (testmodus: sleutel begint met test_).
MOLLIE_API_KEY=test_...

# Resend (mailversturing) + geverifieerd afzenderadres.
RESEND_API_KEY=
RESEND_VAN=Lida Thiry <noreply@voorbeeld.nl>

# Publieke basis-URL (voor Mollie redirect/webhook en de testlink in de mail).
# Lokaal mag dit leeg blijven; op Vercel wordt VERCEL_URL gebruikt of zet je deze expliciet.
NEXT_PUBLIC_SITE_URL=

# Geheim voor de crons (/api/onderhoud/opschonen en de nieuwsbrief-verzendronde
# /api/nb/verwerk). Vercel stuurt dit als
# Authorization: Bearer <CRON_SECRET> wanneer de env-variabele is gezet.
CRON_SECRET=

# Geheim waarmee links in mails worden ondertekend (bijv. "betaling afronden" in
# de betaalherinnering). Lange willekeurige tekst, bijv. `openssl rand -hex 32`.
# Verplicht in productie (VERCEL_ENV=production); lokaal en op previews valt het
# terug op NIEUWSBRIEF_GEHEIM, CRON_SECRET of de Supabase-sleutel.
LINK_GEHEIM=

# Gratis testmodus: alleen de waarde 1 zet bestellen zonder betalen aan. NOOIT in
# productie (zie docs/testomgeving.md).
# GRATIS_TEST=1

# Nieuwsbrief ---------------------------------------------------------------------
# Geheim waarmee kliklinks in nieuwsbrieven worden ondertekend (lange willekeurige
# tekst, bijv. `openssl rand -hex 32`). Leeg = valt terug op CRON_SECRET of de
# Supabase-sleutel; wisselt dat geheim, dan werken oude kliklinks niet meer.
NIEUWSBRIEF_GEHEIM=

# Geheim van de Resend-webhook (Resend → Webhooks → endpoint
# https://<jouw-domein>/api/nb/webhook, gebeurtenissen email.bounced en
# email.complained). Begint met whsec_. Hiermee worden onbestaande adressen
# (bounces) en spamklachten automatisch van de lijst gehaald.
RESEND_WEBHOOK_SECRET=

# Blog ----------------------------------------------------------------------------
# API-sleutel van Anthropic (console.anthropic.com) voor de AI-schrijfhulp in
# Beheer → Blog. Leeg = de schrijfhulp staat uit; zelf schrijven en publiceren
# werkt gewoon. Server-only: nooit als NEXT_PUBLIC_ zetten.
ANTHROPIC_API_KEY=

# Pushmeldingen (Beheer → Meldingen) -----------------------------------------------
# VAPID-sleutelpaar voor webpush. Maak een nieuw paar met
#   node scripts/vapid-sleutels.mjs mailto:jij@jouwdomein.nl
# VAPID_SUBJECT is een mailto:- (of https://-)adres waarop de pushdiensten je kunnen
# bereiken. Leeg = pushmeldingen staan uit. Wissel je de sleutels, dan moet push op
# elk apparaat opnieuw worden aangezet. VAPID_PRIVATE_KEY is server-only (nooit
# als NEXT_PUBLIC_); de publieke sleutel gaat via de beheerpagina naar de browser.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Testomgeving (docs/testomgeving.md) ------------------------------------------------
# Project-ref van de PRODUCTIEdatabase (het stukje vóór .supabase.co). Zet dit in
# Vercel voor Production én Preview: een preview die toch de productiedatabase
# gebruikt, toont dan een rode waarschuwing in het beheer, en
# scripts/backup-terugzetten.mjs weigert naar productie te schrijven.
PRODUCTIE_SUPABASE_REF=
