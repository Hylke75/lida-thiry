# Omgevingsvariabelen van lida-thiry. Kopieer dit bestand naar .env.local voor
# lokale ontwikkeling en zet dezelfde namen in Vercel (Settings → Environment
# Variables). Alles zonder NEXT_PUBLIC_ is server-only: nooit als NEXT_PUBLIC_
# zetten en nooit committen.
#
# Automatisch gezet door Vercel/Node (niet zelf invullen): VERCEL_ENV, VERCEL_URL,
# NODE_ENV en NEXT_RUNTIME.

# Supabase ------------------------------------------------------------------------
# Project "lida-thiry" (ref hzuhkollroehnrsghyax, eu-central-1). De publishable
# (anon) sleutel mag in de browser; RLS beschermt de data.
NEXT_PUBLIC_SUPABASE_URL=https://hzuhkollroehnrsghyax.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_RJa0sZq18sprYJjC9g38pA_q6QrzvNd

# Service-role/secret-sleutel van Supabase (omzeilt RLS). Server-only.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Site ----------------------------------------------------------------------------
# Publieke basis-URL (voor Mollie redirect/webhook, links in mails en de sitemap).
# Lokaal mag dit leeg blijven (dan http://localhost:3000); op Vercel wordt anders
# VERCEL_URL gebruikt. Zet in productie het echte domein, bijv. https://lidathiry.nl.
NEXT_PUBLIC_SITE_URL=

# Reserve-ontvanger van meldingen voor de beheerder (nieuwe bestelling, contact-
# bericht, afspraak, fouten) als in Beheer → Instellingen geen adviseur- of
# contactadres staat.
BEHEER_EMAIL=

# Betalen (Mollie) ----------------------------------------------------------------
# API-sleutel van Mollie. Testmodus zolang de sleutel met test_ begint; in
# productie de live_-sleutel.
MOLLIE_API_KEY=test_...

# Gratis testmodus: alleen precies de waarde 1 zet bestellen zonder betalen aan
# (elke andere waarde, ook "true", doet niets). NOOIT in productie; zie
# docs/testomgeving.md.
# GRATIS_TEST=1

# Mail (Resend) -------------------------------------------------------------------
# API-sleutel van Resend en het (geverifieerde) afzenderadres.
RESEND_API_KEY=
RESEND_VAN=Lida Thiry <noreply@voorbeeld.nl>

# Geheim van de Resend-webhook (Resend → Webhooks → endpoint
# https://<jouw-domein>/api/nb/webhook, gebeurtenissen email.bounced en
# email.complained). Begint met whsec_. Hiermee worden onbestaande adressen
# (bounces) en spamklachten automatisch van de nieuwsbrieflijst gehaald.
RESEND_WEBHOOK_SECRET=

# Geheimen ------------------------------------------------------------------------
# Maak elk geheim met bijv. `openssl rand -hex 32`. Wissel ze niet zonder reden:
# links in al verstuurde mails worden dan ongeldig.

# Geheim voor de crons (/api/onderhoud/opschonen en de nieuwsbrief-verzendronde
# /api/nb/verwerk, zie vercel.json). Vercel stuurt het mee als
# Authorization: Bearer <CRON_SECRET> wanneer de variabele is gezet.
CRON_SECRET=

# Ondertekent links in mails, bijv. "betaling afronden" in de betaalherinnering.
# VERPLICHT in productie (VERCEL_ENV=production); lokaal en op previews valt het
# terug op NIEUWSBRIEF_GEHEIM, CRON_SECRET of de Supabase-sleutel.
LINK_GEHEIM=

# Ondertekent de kliklinks in nieuwsbrieven. VERPLICHT in productie (zonder dit
# geheim kan de nieuwsbrief daar niet versturen); lokaal en op previews valt het
# terug op CRON_SECRET of de Supabase-sleutel.
NIEUWSBRIEF_GEHEIM=

# Blog ----------------------------------------------------------------------------
# API-sleutel van Anthropic (console.anthropic.com) voor de AI-schrijfhulp in
# Beheer → Blog. Leeg = de schrijfhulp staat uit; zelf schrijven en publiceren
# werkt gewoon. Server-only.
ANTHROPIC_API_KEY=

# Pushmeldingen (Beheer → Meldingen) -----------------------------------------------
# VAPID-sleutelpaar voor webpush. Maak een nieuw paar met
#   node scripts/vapid-sleutels.mjs mailto:jij@jouwdomein.nl
# VAPID_SUBJECT is een mailto:- (of https://-)adres waarop de pushdiensten je kunnen
# bereiken. Leeg = pushmeldingen staan uit. Wissel je de sleutels, dan moet push op
# elk apparaat opnieuw worden aangezet. VAPID_PRIVATE_KEY is server-only; de
# publieke sleutel gaat via de beheerpagina naar de browser.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Testomgeving (docs/testomgeving.md) ------------------------------------------------
# Project-ref van de PRODUCTIEdatabase (het stukje vóór .supabase.co). Zet dit in
# Vercel voor Production én Preview: een preview die toch de productiedatabase
# gebruikt, toont dan een rode waarschuwing in het beheer, en
# scripts/backup-terugzetten.mjs weigert naar productie te schrijven.
PRODUCTIE_SUPABASE_REF=
# Alternatief voor PRODUCTIE_SUPABASE_REF: de volledige URL van de productiedatabase
# (https://<ref>.supabase.co). Wordt alleen gebruikt als de ref leeg is.
# PRODUCTIE_SUPABASE_URL=
